# Guia de variables para las configuraciones de ejecucion del IDE.
# Spring Boot no carga este archivo automaticamente. No colocar secretos reales aqui.
DB_USERNAME=
DB_PASSWORD=
JWT_SECRET=
INTERNAL_SECRET=

# Opcionales: solo en auth-service. La cuenta demo esta desactivada por defecto.
DEMO_ENABLED=false
DEMO_ADMIN_EMAIL=admin@fastfood.local
DEMO_ADMIN_PASSWORD=
